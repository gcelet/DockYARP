{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Host": {
    "ShutdownTimeoutSeconds": 30
  },
  "Docker": {
    "Enabled": false,
    "DockerEndpoint": ""
  },
  "Tls": {
    "CertificateDirectory": "certs",
    "AcmeDirectoryUri": "https://acme-staging-v02.api.letsencrypt.org/directory",
    "AcceptTermsOfService": false,
    "RenewBeforeExpiry": "30.00:00:00",
    "CheckInterval": "12:00:00"
  },
  "Security": {
    "EnableHsts": true,
    "HstsMaxAge": "365.00:00:00",
    "HstsIncludeSubDomains": false,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer"
  },
  "AdminApi": {
    "ApiKey": ""
  }
}
